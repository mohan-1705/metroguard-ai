# Database Configuration
# Use postgresql://postgres:postgres@localhost:5432/metroguard or similar.
# The app will automatically fall back to sqlite:///metroguard.db if PostgreSQL is unavailable.
DATABASE_URL=sqlite:///metroguard.db

# LLM Configuration
# Use local Ollama by default
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# RAG Configuration
FAISS_INDEX_PATH=rag_index
TOP_K=3
CHUNK_SIZE=500

# WebSocket & Server Settings
VITE_API_BASE_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000/ws/sensors
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
